# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.

# Google AI Studio → API key
GEMINI_API_KEY=
# Exact model names: run `npm run smoke -- --models` to list what your key can use
GEMINI_MODEL_FAST=      # current Gemini Flash model (report analysis)
GEMINI_MODEL_SMART=     # current Gemini Pro model (RCA, pattern naming)
GEMINI_EMBED_MODEL=     # current Gemini embedding model

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # SECRET key (sb_secret_… or legacy service_role), server only. Not the publishable key!

# Pattern matching threshold (cosine similarity), tune on seed data
SIM_THRESHOLD=0.85
